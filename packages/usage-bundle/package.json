{
  "name": "@dsh-usage-meter/usage-bundle",
  "description": "Installable dsh profile bundle: mounts the usage recorder host plugin and its Web GUI dashboard in one layer.",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cute-baobao/dsh-usage-meter.git",
    "directory": "packages/usage-bundle"
  },
  "keywords": [
    "deepseek-harness",
    "plugin",
    "bundle",
    "usage"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@dsh-usage-meter/usage-host": "workspace:^",
    "@dsh-usage-meter/usage-ui": "workspace:^"
  }
}
