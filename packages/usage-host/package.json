{
  "name": "@dsh-usage-meter/usage-host",
  "description": "Host-side DeepSeek Harness usage recorder: folds session events into per-model daily token usage, persists a JSONL call ledger under $DSH_HOME/usage-meter, and exposes the usage-meter Typert remote service for the Web GUI.",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.js"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsdown",
    "bundle": "tsdown"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-home-paths": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-protocol": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6"
  }
}
